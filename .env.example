# Only needed once you switch lib/getPlaces.ts over to Supabase (see README).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional - only needed for the "Hybrid" map style (satellite + labels).
# Get a free key at maptiler.com. Without this set, the map still works
# fine with Standard (OpenStreetMap) and Satellite (Esri, free/keyless) -
# the Hybrid option simply won't appear in the style switcher.
NEXT_PUBLIC_MAPTILER_KEY=
